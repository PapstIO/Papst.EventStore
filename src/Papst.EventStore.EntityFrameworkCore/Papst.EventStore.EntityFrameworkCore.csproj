<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Papst.EventStore.EntityFrameworkCore</PackageId>
    <Title>Papst EventStore Entity Framework Core</Title>
    <Description>Entity Framework Core based EventStore implementation for Papst.EventStore, including SQL Server migrations.</Description>
    <PackageTags>eventsourcing;eventstore;entityframeworkcore;sqlserver;cqrs</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Papst.EventStore\Papst.EventStore.csproj" Condition="'$(Configuration)' == 'DEBUG'" />
    <PackageReference Include="Papst.EventStore" Condition="'$(Configuration)' != 'DEBUG'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Design-time tooling only: must not become a runtime dependency of the package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- Required at compile time: the shipped migrations call SqlServerModelBuilderExtensions. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>
